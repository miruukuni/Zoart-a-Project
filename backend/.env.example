SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR_BACKEND_SECRET_KEY
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_SEARCH_MODEL=gemini-3.5-flash-lite
GEMINI_MODERATION_MODEL=gemini-3.6-flash
GEMINI_REPORT_MODEL=gemini-3.5-flash-lite
# Free-tier availability and limits depend on your Google API project.
# 3.8 flash is slow so I'm making it for search only, 3.6 is faster and is slighter smarter than 3.5 flash lite so it's for moderation, 3.5 have the most daily usage so im setting it as the rest
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
